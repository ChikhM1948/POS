{
  "name": "@pos-dz/desktop",
  "version": "0.1.2",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/bundle.js && electron dist/main.js",
    "build": "tsc -p . --noEmit && node scripts/fetch-native.js && node scripts/bundle.js && node scripts/copy-renderer.js && electron-builder --win",
    "typecheck": "tsc -p . --noEmit",
    "make:zip": "node scripts/make-zip.js",
    "publish:update": "node scripts/publish-update.js"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "electron-updater": "^6.8.11",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "7zip-bin": "^5.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "esbuild": "^0.28.2",
    "resedit": "^2.0.3",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "dz.posalgerie.desktop",
    "productName": "POS Algerie",
    "electronVersion": "31.7.7",
    "npmRebuild": false,
    "afterPack": "scripts/set-exe-icon.js",
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "pos.png",
      "icon.ico",
      "!**/node_modules/better-sqlite3/{deps,src,build}/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "icon.ico"
    },
    "extraResources": [
      {
        "from": "native/win32-x64/better_sqlite3.node",
        "to": "native/better_sqlite3.node"
      }
    ],
    "asarUnpack": [
      "**/@node-usb/**/*.node"
    ],
    "portable": {
      "artifactName": "POS-Algerie-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "POS-Algerie-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "${env.POS_UPDATE_URL}"
      }
    ]
  },
  "optionalDependencies": {
    "@node-usb/usb-win32-x64-msvc": "3.1.0"
  }
}
