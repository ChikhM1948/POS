PORT=4000
# Dev local : mongodb://localhost:27017/pos-dz
# Production (MongoDB Atlas) : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pos-dz?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pos-dz
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
# Liste d'origines autorisées séparées par des virgules. Pour un déploiement avec l'app desktop
# Electron packagée, ajoutez son origine locale à port fixe (voir apps/desktop/main.ts,
# RENDERER_PORT) en plus du domaine du front web :
# CORS_ORIGIN=https://caisse.votredomaine.dz,http://127.0.0.1:47623
CORS_ORIGIN=http://localhost:3000

# --- Licences & mises à jour desktop ---
# Générer la paire de clés : node ../../scripts/license-keygen.js  (colle la clé privée ici, embarque la publique dans le desktop)
LICENSE_PRIVATE_KEY=
# Secret éditeur : émission/révocation de clés (POST /license/generate) et publication des mises à jour (PUT /updates/files/:name)
LICENSE_ADMIN_KEY=
# Compte super admin (interface /superadmin) : créé hors-ligne, jamais via l'API —
#   SUPERADMIN_EMAIL=moi@exemple.com SUPERADMIN_PASSWORD='10+ caractères' npm run create:superadmin -w @pos-dz/api
# Dossier des mises à jour desktop (volume persistant en production)
UPDATES_DIR=./updates

# --- Paiement en ligne des licences (SofizPay, CIB / Dahabia) — mêmes valeurs que la webapp Lingolab ---
SOFIZPAY_API_KEY=
# URL publique du front web (retour client après paiement)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Prix de la licence à vie en DZD
LICENSE_LIFETIME_PRICE_DZD=8000
# Callback SofizPay (sans secret) : https://<api>/license/sofizpay/webhook — le paiement est revérifié chez SofizPay
